# ───────────────────────────────────────────────────────────────
# Hey backend — environment variables
# Copy to `.env` and fill in. Defaults let the app boot locally
# against docker-compose's services.
# ───────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── Database (Postgres — production runs on Neon) ─────────────
# Production: Neon serverless URL — looks like
#   postgresql://user:pass@ep-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Local dev: local Postgres via docker-compose.
DATABASE_URL="postgres://hey:hey@localhost:5432/hey?schema=public"
SHADOW_DATABASE_URL="postgres://hey:hey@localhost:5432/hey_shadow?schema=public"

# OR split parts — the app assembles DATABASE_URL if it's unset and
# DB_USER + DB_NAME are provided. Nice on hosts whose UI mangles URLs.
# DB_USER=hey
# DB_PASS=hey
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=hey

# ── JWT ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-in-prod
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=60d

# ── Twilio (SMS OTP) ───────────────────────────────────────────
TWILIO_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
# Stub only: the fixed code that always passes (blank = accept any code)
OTP_STUB_CODE=123456

# ── S3-compatible storage (photos) ─────────────────────────────
S3_PROVIDER=stub
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_STUB_DIR=./.local-s3
PUBLIC_BASE_URL=
PHOTO_MAX_MB=10
STORAGE_URL_TTL_S=900

# ── FCM (push) ─────────────────────────────────────────────────
FCM_PROVIDER=stub
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=

# ── Feature config ─────────────────────────────────────────────
UNMATCH_SILENCE_DAYS=14
ACCOUNT_PURGE_DAYS=30

# Discovery ranking weights (5 terms; sum need not be 1).
# `feed_config` singleton in the DB is authoritative — env values are
# only used as fallback if the row is missing.
FEED_W_RECENCY=0.30
FEED_W_MUTUAL_INTERESTS=0.25
FEED_W_DISTANCE=0.20
FEED_W_RECIPROCAL=0.20
FEED_W_RECENT_SHOWN_PENALTY=0.05

# ── Rate limits (per-user windows in seconds) ──────────────────
RL_OTP_PER_HOUR=5
RL_LIKES_PER_DAY=200
RL_REPORTS_PER_DAY=10
RL_MESSAGES_PER_MIN=60
