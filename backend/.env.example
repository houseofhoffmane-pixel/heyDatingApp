# ───────────────────────────────────────────────────────────────
# Hey backend — environment variables
# Copy to `.env` and fill in. Defaults below let the app boot
# locally against docker-compose's services.
# ───────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── Database (PostGIS enabled) ─────────────────────────────────
DATABASE_URL=postgres://hey:hey@localhost:5432/hey?schema=public
SHADOW_DATABASE_URL=postgres://hey:hey@localhost:5432/hey_shadow?schema=public

# ── Redis (presence, counters, BullMQ, socket adapter) ─────────
REDIS_URL=redis://localhost:6379

# ── JWT ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-in-prod
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=60d

# ── Admin JWT (separate signing key) ───────────────────────────
ADMIN_JWT_SECRET=dev-admin-secret-change-in-prod
ADMIN_JWT_TTL=8h

# ── External service providers ─────────────────────────────────
# All providers ship with a stub implementation that works offline.
# Set PROVIDER=real and fill the keys to flip to live.

# Twilio (SMS / OTP)
TWILIO_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
# Stub-only: the fixed code that always passes (set blank to accept any)
OTP_STUB_CODE=123456

# AWS S3 (photos, selfies)
S3_PROVIDER=stub
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Stub: where uploaded files are stored locally
S3_STUB_DIR=./.local-s3
# Public base URL used by the stub when minting upload/read links.
# Defaults to http://localhost:<PORT>. Set if you host on a different host.
PUBLIC_BASE_URL=
# Photos: max accepted upload size in MB (PUT bodies above this are rejected)
PHOTO_MAX_MB=10
# Upload/read URL TTL in seconds.
STORAGE_URL_TTL_S=900

# Rekognition (face match)
REKOGNITION_PROVIDER=stub
REKOGNITION_REGION=us-east-1
FACE_MATCH_THRESHOLD=90
# Stub: confidence value the stub returns for every comparison
REKOGNITION_STUB_CONFIDENCE=95

# FCM (push)
FCM_PROVIDER=stub
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=

# Mapbox (admin geocoding)
MAPBOX_PROVIDER=stub
MAPBOX_TOKEN=

# ── Feature config (also tunable from /admin/config/feed-weights) ──
CHECKIN_RADIUS_M=100
CHECKIN_TTL_HOURS=2
UNMATCH_SILENCE_DAYS=14
ACCOUNT_PURGE_DAYS=30

# Discovery ranking weights (sum need not be 1)
FEED_W_RECENCY=0.25
FEED_W_MUTUAL_INTERESTS=0.20
FEED_W_SAME_SPOT=0.20
FEED_W_DISTANCE=0.15
FEED_W_RECIPROCAL=0.15
FEED_W_RECENT_SHOWN_PENALTY=0.05

# ── Rate limits (per-user windows in seconds) ──────────────────
RL_OTP_PER_HOUR=5
RL_LIKES_PER_DAY=200
RL_CHECKINS_PER_5MIN=1
RL_REPORTS_PER_DAY=10
RL_MESSAGES_PER_MIN=60
