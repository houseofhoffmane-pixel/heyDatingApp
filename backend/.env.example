# ───────────────────────────────────────────────────────────────
# Hey backend — environment variables
# Copy to `.env` and fill in. Defaults let the app boot locally
# against docker-compose's services.
# ───────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── Database (MySQL 8) ─────────────────────────────────────────
# Two ways to configure — pick one:
#
#  1. Full URL (traditional):
DATABASE_URL="mysql://hey:hey@localhost:3306/hey"
#
#  2. OR separate parts (nicer on Hostinger's env-var UI because you
#     don't have to URL-encode symbols in the password). If DATABASE_URL
#     is unset AND DB_USER + DB_NAME are set, the app assembles the URL
#     at boot with proper encoding. DB_HOST defaults to 'localhost',
#     DB_PORT to '3306'.
#
# DB_USER=hey
# DB_PASS=hey
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=hey

SHADOW_DATABASE_URL="mysql://hey:hey@localhost:3306/hey_shadow"

# ── JWT ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-in-prod
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=60d

# ── Twilio (SMS OTP) ───────────────────────────────────────────
TWILIO_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
# Stub only: the fixed code that always passes (blank = accept any code)
OTP_STUB_CODE=123456

# ── S3-compatible storage (photos) ─────────────────────────────
S3_PROVIDER=stub
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_STUB_DIR=./.local-s3
PUBLIC_BASE_URL=
PHOTO_MAX_MB=10
STORAGE_URL_TTL_S=900

# ── FCM (push) ─────────────────────────────────────────────────
FCM_PROVIDER=stub
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=

# ── Feature config ─────────────────────────────────────────────
UNMATCH_SILENCE_DAYS=14
ACCOUNT_PURGE_DAYS=30

# Discovery ranking weights (5 terms; sum need not be 1).
# `feed_config` singleton in the DB is authoritative — env values are
# only used as fallback if the row is missing.
FEED_W_RECENCY=0.30
FEED_W_MUTUAL_INTERESTS=0.25
FEED_W_DISTANCE=0.20
FEED_W_RECIPROCAL=0.20
FEED_W_RECENT_SHOWN_PENALTY=0.05

# ── Rate limits (per-user windows in seconds) ──────────────────
RL_OTP_PER_HOUR=5
RL_LIKES_PER_DAY=200
RL_REPORTS_PER_DAY=10
RL_MESSAGES_PER_MIN=60
