// Hey — Prisma schema (ship-scope, MySQL 8).
//
// Sprint 3 swap: PostgreSQL/PostGIS → MySQL 8 (Hostinger managed DB).
//
// Type mapping:
//   - PostGIS geography(Point, 4326) → MySQL POINT (SRID 0, unprojected).
//     Distance is computed with ST_Distance_Sphere in meters — SRID 4326
//     axis-order ambiguity avoids all of us a debugging afternoon.
//     Prisma has no first-class POINT type, so the column is defined in
//     the init migration and hidden from the client via `location Unsupported`.
//   - Postgres text[] arrays → JSON columns. Prisma exposes these as
//     `Prisma.JsonValue`; callers cast to `string[]` on read.
//   - @db.Uuid → @db.Char(36). Prisma generates the UUID client-side.
//   - @db.Timestamptz(6) → @db.Timestamp(6). MySQL stores UTC + fractional.
//
// DB columns stay snake_case; TS models stay camelCase via @map/@@map.

// driverAdapters preview lets us bypass Prisma's Rust Query Engine
// entirely and use a pure-Node MySQL driver (mariadb, which speaks
// MySQL wire protocol). Prisma's Rust engine PANICs with "timer has
// gone away" on Hostinger's shared hosting regardless of engineType
// (library or binary) — known tokio/libuv interop issue on their
// specific Linux/glibc combo. The driver adapter route sidesteps
// the entire Rust runtime.
//
// binaryTargets still listed so `prisma generate` succeeds on local
// dev; runtime uses the adapter, not the binary.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum UserStatus {
  onboarding
  active
  paused
  hidden
  banned
  deleted
}

enum Visibility {
  everyone
  liked_only
}

enum Gender {
  woman
  man
  non_binary
  trans_woman
  trans_man
  genderfluid
  other
}

enum RelationshipIntent {
  longterm
  longterm_open
  short_open
  short
  figuring_out
  friends
}

enum StarSign {
  aries
  taurus
  gemini
  cancer
  leo
  virgo
  libra
  scorpio
  sagittarius
  capricorn
  aquarius
  pisces
}

enum Drinks {
  often
  socially
  rarely
  never
}

enum Smokes {
  regularly
  socially
  trying_to_quit
  never
}

enum Exercise {
  daily
  few_week
  sometimes
  never
}

enum Weed420 {
  yes
  sometimes
  never
}

enum Kids {
  want
  have_want_more
  have_done
  dont_want
  open
  not_sure
}

enum Politics {
  left
  moderate
  right
  not_political
  rather_not_say
}

enum Religion {
  agnostic
  atheist
  christian
  jewish
  muslim
  hindu
  buddhist
  spiritual
  other
}

enum Monogamy {
  monogamous
  monogamish
  non_monogamous
  figuring
}

enum PhotoStatus {
  pending
  approved
  rejected
}

enum LikeAnchorType {
  photo
  prompt
}

enum MatchStatus {
  active
  unmatched
  expired
}

enum MessageKind {
  text
  place_share      // vestigial — retained so existing rows don't fail to load; frontend never sends this
  location_share
  system
}

enum MessageStatus {
  sent
  delivered
  read
  failed
}

// Only `profile` targets remain (no spots/events to report).
enum ReportTargetType {
  profile
}

enum ReportReason {
  fake
  inappropriate
  harassment
  spam
  underage
  scam
  other
}

enum ReportStatus {
  pending
  reviewed
  actioned
  dismissed
}

enum DevicePlatform {
  ios
  android
  web
}

enum LinkedProvider {
  instagram
  spotify
}

// ─────────────────────────────────────────────────────────────
// users
// ─────────────────────────────────────────────────────────────

model User {
  id              String      @id @default(uuid()) @db.Char(36)
  phoneE164       String      @unique @map("phone_e164") @db.VarChar(32)
  countryCode     String      @map("country_code") @db.VarChar(4)
  email           String?     @unique @db.VarChar(255)
  passwordHash    String?     @map("password_hash") @db.VarChar(255)
  dob             DateTime?   @db.Date
  status          UserStatus  @default(onboarding)
  visibility      Visibility  @default(everyone)
  autoResumeAt    DateTime?   @map("auto_resume_at") @db.Timestamp(6)
  lastActiveAt    DateTime    @default(now()) @map("last_active_at") @db.Timestamp(6)
  ageConfirmed    Boolean     @default(false) @map("age_confirmed")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamp(6)

  profile             Profile?
  photos              Photo[]            @relation("PhotoOwner")
  likesGiven          Like[]             @relation("LikeFrom")
  likesReceived       Like[]             @relation("LikeTo")
  matchesA            Match[]            @relation("MatchA")
  matchesB            Match[]            @relation("MatchB")
  messages            Message[]          @relation("MessageSender")
  blocksGiven         Block[]            @relation("Blocker")
  blocksReceived      Block[]            @relation("Blocked")
  reportsFiled        Report[]           @relation("Reporter")
  emergencyContact    EmergencyContact?
  notifications       Notification[]
  deviceTokens        DeviceToken[]
  linkedAccounts      LinkedAccount[]
  settings            UserSettings?
  filters             Filters?
  refreshTokens       RefreshToken[]
  otpAttempts         OtpAttempt[]

  @@index([phoneE164])
  @@index([status])
  @@index([lastActiveAt])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// profiles
//
// `location` (POINT) is defined in the init migration — Prisma doesn't
// model spatial types. GeoService reads/writes via raw SQL.
// ─────────────────────────────────────────────────────────────

model Profile {
  id                  String              @id @default(uuid()) @db.Char(36)
  userId              String              @unique @map("user_id") @db.Char(36)
  // The 6 fields below are mandatory before status can advance to `active`.
  // Nullable in the DB so a Profile row can exist during partial onboarding;
  // OnboardingService validates presence + ranges before flipping status.
  name                String?             @db.VarChar(80)
  gender              Gender?
  genderCustom        String?             @map("gender_custom") @db.VarChar(80)
  // JSON string[] — values: women / men / non-binary / everyone
  lookingFor          Json                @map("looking_for")
  relationshipIntent  RelationshipIntent? @map("relationship_intent")
  heightCm            Int?                @map("height_cm")
  bio                 String?             @db.VarChar(180)
  job                 String?             @db.VarChar(120)
  school              String?             @db.VarChar(120)
  pronouns            String?             @db.VarChar(40)
  starSign            StarSign?           @map("star_sign")
  drinks              Drinks?
  smokes              Smokes?
  exercise            Exercise?
  weed420             Weed420?            @map("weed_420")
  kids                Kids?
  politics            Politics?
  religion            Religion?
  monogamy            Monogamy?
  completionPct       Int                 @default(0) @map("completion_pct")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamp(6)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests   ProfileInterest[]
  prompts     ProfilePrompt[]
  photos      Photo[]

  @@map("profiles")
}

// ─────────────────────────────────────────────────────────────
// interests + profile_interests
// ─────────────────────────────────────────────────────────────

model Interest {
  id        String   @id @default(uuid()) @db.Char(36)
  slug      String   @unique @db.VarChar(64)
  label     String   @db.VarChar(80)
  category  String   @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  profiles  ProfileInterest[]

  @@map("interests")
}

model ProfileInterest {
  profileId  String   @map("profile_id") @db.Char(36)
  interestId String   @map("interest_id") @db.Char(36)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([profileId, interestId])
  @@map("profile_interests")
}

// ─────────────────────────────────────────────────────────────
// prompts + profile_prompts
// ─────────────────────────────────────────────────────────────

model Prompt {
  id        String   @id @default(uuid()) @db.Char(36)
  text      String   @db.VarChar(140)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  answers   ProfilePrompt[]

  @@map("prompts")
}

model ProfilePrompt {
  id        String   @id @default(uuid()) @db.Char(36)
  profileId String   @map("profile_id") @db.Char(36)
  promptId  String   @map("prompt_id") @db.Char(36)
  answer    String   @db.VarChar(280)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  prompt      Prompt  @relation(fields: [promptId], references: [id], onDelete: Restrict)
  likeAnchors Like[]  @relation("LikePromptAnchor")

  @@unique([profileId, position])
  @@index([profileId])
  @@map("profile_prompts")
}

// ─────────────────────────────────────────────────────────────
// photos
// ─────────────────────────────────────────────────────────────

model Photo {
  id          String      @id @default(uuid()) @db.Char(36)
  profileId   String      @map("profile_id") @db.Char(36)
  userId      String      @map("user_id") @db.Char(36)
  s3Key       String      @map("s3_key") @db.VarChar(255)
  position    Int
  isMain      Boolean     @default(false) @map("is_main")
  nsfwScore   Float?      @map("nsfw_score")
  status      PhotoStatus @default(pending)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamp(6)

  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user        User    @relation("PhotoOwner", fields: [userId], references: [id], onDelete: Cascade)
  likeAnchors Like[]  @relation("LikePhotoAnchor")

  @@unique([profileId, position])
  @@index([profileId])
  @@map("photos")
}

// ─────────────────────────────────────────────────────────────
// likes
// ─────────────────────────────────────────────────────────────

model Like {
  id              String         @id @default(uuid()) @db.Char(36)
  fromUserId      String         @map("from_user_id") @db.Char(36)
  toUserId        String         @map("to_user_id") @db.Char(36)
  anchorType      LikeAnchorType @map("anchor_type")
  anchorPhotoId   String?        @map("anchor_photo_id") @db.Char(36)
  anchorPromptId  String?        @map("anchor_prompt_id") @db.Char(36)
  comment         String?        @db.VarChar(140)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamp(6)

  fromUser     User           @relation("LikeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser       User           @relation("LikeTo",   fields: [toUserId],   references: [id], onDelete: Cascade)
  anchorPhoto  Photo?         @relation("LikePhotoAnchor",  fields: [anchorPhotoId],  references: [id], onDelete: SetNull)
  anchorPrompt ProfilePrompt? @relation("LikePromptAnchor", fields: [anchorPromptId], references: [id], onDelete: SetNull)
  matchA       Match?         @relation("MatchLikeA")
  matchB       Match?         @relation("MatchLikeB")

  @@unique([fromUserId, toUserId])
  @@index([toUserId, createdAt])
  @@map("likes")
}

// passes — separate table (skip tracking, feed exclusion)
model Pass {
  id         String   @id @default(uuid()) @db.Char(36)
  fromUserId String   @map("from_user_id") @db.Char(36)
  toUserId   String   @map("to_user_id") @db.Char(36)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([fromUserId, toUserId])
  @@map("passes")
}

// ─────────────────────────────────────────────────────────────
// matches
// ─────────────────────────────────────────────────────────────

model Match {
  id            String      @id @default(uuid()) @db.Char(36)
  userAId       String      @map("user_a_id") @db.Char(36)
  userBId       String      @map("user_b_id") @db.Char(36)
  likeAId       String      @unique @map("like_a_id") @db.Char(36)
  likeBId       String      @unique @map("like_b_id") @db.Char(36)
  status        MatchStatus @default(active)
  lastMessageAt DateTime?   @map("last_message_at") @db.Timestamp(6)
  unmatchedBy   String?     @map("unmatched_by") @db.Char(36)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamp(6)

  userA    User      @relation("MatchA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("MatchB", fields: [userBId], references: [id], onDelete: Cascade)
  likeA    Like      @relation("MatchLikeA", fields: [likeAId], references: [id], onDelete: Cascade)
  likeB    Like      @relation("MatchLikeB", fields: [likeBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId, status, lastMessageAt])
  @@index([userBId, status, lastMessageAt])
  @@map("matches")
}

// ─────────────────────────────────────────────────────────────
// messages
// ─────────────────────────────────────────────────────────────

model Message {
  id        String        @id @default(uuid()) @db.Char(36)
  matchId   String        @map("match_id") @db.Char(36)
  senderId  String        @map("sender_id") @db.Char(36)
  body      String        @db.Text
  kind      MessageKind   @default(text)
  status    MessageStatus @default(sent)
  clientId  String        @map("client_id") @db.VarChar(64)
  readAt    DateTime?     @map("read_at") @db.Timestamp(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamp(6)

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User  @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([matchId, senderId, clientId])
  @@index([matchId, createdAt])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────
// blocks + reports
// ─────────────────────────────────────────────────────────────

model Block {
  blockerId String   @map("blocker_id") @db.Char(36)
  blockedId String   @map("blocked_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Report {
  id          String           @id @default(uuid()) @db.Char(36)
  reporterId  String           @map("reporter_id") @db.Char(36)
  targetType  ReportTargetType @map("target_type")
  targetId    String           @map("target_id") @db.Char(36)
  reason      ReportReason
  detail      String           @db.VarChar(280)
  status      ReportStatus     @default(pending)
  reviewedBy  String?          @map("reviewed_by") @db.Char(36)
  reviewNote  String?          @map("review_note") @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamp(6)

  reporter    User    @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([targetType, targetId])
  @@map("reports")
}

// ─────────────────────────────────────────────────────────────
// emergency_contacts
// ─────────────────────────────────────────────────────────────

model EmergencyContact {
  id                 String   @id @default(uuid()) @db.Char(36)
  userId             String   @unique @map("user_id") @db.Char(36)
  name               String   @db.VarChar(80)
  phoneE164          String   @map("phone_e164") @db.VarChar(32)
  autoShareFirstDate Boolean  @default(false) @map("auto_share_first_date")
  checkinTimer       Boolean  @default(false) @map("checkin_timer")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

// ─────────────────────────────────────────────────────────────
// notifications + device_tokens
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  type      String   @db.VarChar(40)
  payload   Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model DeviceToken {
  id        String         @id @default(uuid()) @db.Char(36)
  userId    String         @map("user_id") @db.Char(36)
  fcmToken  String         @map("fcm_token") @db.VarChar(255)
  platform  DevicePlatform
  lastSeen  DateTime       @default(now()) @map("last_seen") @db.Timestamp(6)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fcmToken])
  @@map("device_tokens")
}

// ─────────────────────────────────────────────────────────────
// linked_accounts
// ─────────────────────────────────────────────────────────────

model LinkedAccount {
  id          String         @id @default(uuid()) @db.Char(36)
  userId      String         @map("user_id") @db.Char(36)
  provider    LinkedProvider
  handle      String         @db.VarChar(120)
  data        Json?
  connectedAt DateTime       @default(now()) @map("connected_at") @db.Timestamp(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("linked_accounts")
}

// ─────────────────────────────────────────────────────────────
// user_settings
// ─────────────────────────────────────────────────────────────

model UserSettings {
  userId            String   @id @map("user_id") @db.Char(36)

  notifyMatches     Boolean  @default(true)  @map("notify_matches")
  notifyMessages    Boolean  @default(true)  @map("notify_messages")
  notifyLikes       Boolean  @default(true)  @map("notify_likes")
  notifyPlaces      Boolean  @default(true)  @map("notify_places")   // vestigial toggle; harmless
  notifyEvents      Boolean  @default(true)  @map("notify_events")   // vestigial toggle; harmless
  notifyNews        Boolean  @default(false) @map("notify_news")
  emailDigest       Boolean  @default(false) @map("email_digest")
  quietHoursStart   Int?     @map("quiet_hours_start")
  quietHoursEnd     Int?     @map("quiet_hours_end")

  readReceipts      Boolean  @default(true) @map("read_receipts")
  activeStatus      Boolean  @default(true) @map("active_status")
  blurExplicit      Boolean  @default(true) @map("blur_explicit")
  showMeOnPlaces    Boolean  @default(true) @map("show_me_on_places") // vestigial; kept to avoid a needless drop

  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ─────────────────────────────────────────────────────────────
// filters
//
// All array fields are JSON columns. Prisma exposes them as
// `Prisma.JsonValue`; the service layer casts to `string[]` on read.
// ─────────────────────────────────────────────────────────────

model Filters {
  userId          String   @id @map("user_id") @db.Char(36)

  lookingFor      Json     @map("looking_for")
  relationship    Json
  drinks          Json
  smokes          Json
  exercise        Json
  weed420         Json     @map("weed_420")
  kids            Json
  politics        Json
  religion        Json
  monogamy        Json
  starSign        Json     @map("star_sign")
  interests       Json

  ageMin          Int      @default(18) @map("age_min")
  ageMax          Int      @default(99) @map("age_max")
  heightMinCm     Int      @default(120) @map("height_min_cm")
  heightMaxCm     Int      @default(220) @map("height_max_cm")
  distanceMi      Int      @default(25) @map("distance_mi")
  showMeOnPlaces  Boolean  @default(true) @map("show_me_on_places") // vestigial

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("filters")
}

// ─────────────────────────────────────────────────────────────
// Auth — refresh tokens (rotated, hashed)
// ─────────────────────────────────────────────────────────────

model RefreshToken {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  family     String    @db.VarChar(64)
  parentId   String?   @map("parent_id") @db.Char(36)
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  ip         String?   @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamp(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────
// Auth — OTP attempts
// ─────────────────────────────────────────────────────────────

model OtpAttempt {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String?  @map("user_id") @db.Char(36)
  phoneE164 String   @map("phone_e164") @db.VarChar(32)
  success   Boolean  @default(false)
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneE164, createdAt])
  @@map("otp_attempts")
}

// ─────────────────────────────────────────────────────────────
// Feed-weight config (singleton, tunable — 5 terms now)
// ─────────────────────────────────────────────────────────────

model FeedConfig {
  id                       Int      @id @default(1)
  wRecency                 Float    @default(0.30) @map("w_recency")
  wMutualInterests         Float    @default(0.25) @map("w_mutual_interests")
  wDistance                Float    @default(0.20) @map("w_distance")
  wReciprocal              Float    @default(0.20) @map("w_reciprocal")
  wRecentlyShownPenalty    Float    @default(0.05) @map("w_recently_shown_penalty")
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("feed_config")
}
